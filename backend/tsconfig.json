{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "lib": [
      "ES2020"
    ],

    "types": [
      "node"
    ],

    "outDir": "dist",
    "rootDir": "src",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "verbatimModuleSyntax": false,

    "declaration": false,

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}